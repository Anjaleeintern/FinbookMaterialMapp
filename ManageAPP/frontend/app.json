{
  "expo": {
    "name": "MaterialMapp",
    "slug": "materialmapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.materialmapp.app"
    },
    "android": {
      "package": "com.materialmapp.app",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "8d42c541-7bc0-4e92-82b0-06ecbe04e883"
      }
    },
    "plugins": [
      "expo-font",
      "expo-sharing"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8d42c541-7bc0-4e92-82b0-06ecbe04e883"
    }
  }
}
