# Frontend API Configuration Template
# In Expo SDK 49+, environment variables with EXPO_PUBLIC_ prefix are accessible via process.env

# Backend Host (PC's Local Network IP or Domain)
EXPO_PUBLIC_BACKEND_HOST=192.168.1.15

# Backend Port
EXPO_PUBLIC_BACKEND_PORT=8000

# Mobile Bridge Proxy Port
EXPO_PUBLIC_PROXY_PORT=8005

# Optional Direct Full API URL
EXPO_PUBLIC_API_URL=
