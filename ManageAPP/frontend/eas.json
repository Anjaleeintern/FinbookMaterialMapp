{
  "cli": {
    "version": ">= 21.7.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://finbookmaterialmapp.onrender.com",
        "EXPO_PUBLIC_PROD_API_URL": "https://finbookmaterialmapp.onrender.com"
      },
      "channel": "preview"
    },
    "preview-simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://finbookmaterialmapp.onrender.com",
        "EXPO_PUBLIC_PROD_API_URL": "https://finbookmaterialmapp.onrender.com"
      },
      "channel": "preview-simulator"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://finbookmaterialmapp.onrender.com",
        "EXPO_PUBLIC_PROD_API_URL": "https://finbookmaterialmapp.onrender.com"
      },
      "channel": "production"
    },
    "production-apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://finbookmaterialmapp.onrender.com",
        "EXPO_PUBLIC_PROD_API_URL": "https://finbookmaterialmapp.onrender.com"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
